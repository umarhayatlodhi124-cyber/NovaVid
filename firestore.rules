rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'umarhayatlodhi124@gmail.com' ||
        request.auth.token.email == 'umarhayatlodhi25@gmail.com'
      );
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // 1. Users collection & nested customer subcollections (Phase F Multi-Tenant Architecture)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Prevent non-admins from self-elevating role, isOwner or plan
      allow update: if (
        isOwner(userId) &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
        (!('isOwner' in resource.data) || request.resource.data.isOwner == resource.data.isOwner) &&
        (!('plan' in resource.data) || request.resource.data.plan == resource.data.plan)
      ) || isAdmin();
      allow delete: if isAdmin();

      // Nested customer subcollections (Phase F: Multi-Tenant Subcollections)
      match /projects/{projectId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /scripts/{scriptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /assets/{assetId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /publishing/{recordId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /automation/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /daily_jobs/{jobId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /subscriptions/{subId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Automation top-level collections (isolated by userId)
    match /automation_configs/{configId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /automation_jobs/{jobId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 2. Organizations & Memberships
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow write: if isAdmin();

      match /members/{memberId} {
        allow read: if isOrgMember(orgId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // 3. User Projects & Production Data
    match /projects/{projectId} {
      allow read: if isOwner(resource.data.userId) || (resource.data.orgId != null && isOrgMember(resource.data.orgId)) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /scripts/{scriptId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /storyboards/{storyboardId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /scenes/{sceneId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /media_assets/{assetId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    // 4. Video Jobs & Render Tasks
    match /video_jobs/{jobId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /job_events/{eventId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /render_tasks/{taskId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    // 5. AI Providers & Provider Usage
    match /ai_providers/{providerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /provider_usage/{usageId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. YouTube Accounts & Published Videos
    match /youtube_accounts/{accId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    match /published_videos/{videoId} {
      allow read, write: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated();
    }

    // 7. Subscriptions, Entitlements & Licenses (Server Authoritative)
    match /plans/{planId} {
      allow read: if true; // Public pricing/plans
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin(); // Server/Webhook only
    }

    match /entitlements/{entId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin(); // Server only
    }

    match /licenses/{licId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin(); // Server only
    }

    // 8. Analytics & Storage Usage
    match /analytics/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin();
    }

    match /storage_usage/{docId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin();
    }

    // 9. Notifications & Support Tickets
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 10. Audit Logs (Immutable, Admin Read-Only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
