# NovaVid AI YouTube Studio — Production Environment Variables Template
# Copy to .env and configure secrets. NEVER commit actual production secrets to git!

# ----------------- SERVER CONFIGURATION -----------------
PORT=3001
NODE_ENV=production
API_BASE_URL=https://api.novavid.studio
CORS_ORIGIN=*

# ----------------- DATABASE (POSTGRESQL) -----------------
# Example for Neon / Supabase: postgresql://user:password@ep-project.region.neon.tech/novavid?sslmode=require
DATABASE_URL=postgresql://novavid_user:replace_with_secure_password@localhost:5432/novavid_production
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ----------------- AUTHENTICATION (JWT) -----------------
# 64-character random hex string for JWT HMAC signing
JWT_SECRET=replace_with_random_64_character_hex_secret_key_here
SESSION_EXPIRATION_HOURS=720

# ----------------- ASYMMETRIC ED25519 LICENSING -----------------
# Base64-encoded PKCS#8 DER Ed25519 Private Key (SERVER-SIDE ONLY)
ED25519_PRIVATE_KEY_PKCS8=replace_with_base64_encoded_pkcs8_private_key
# Base64-encoded SPKI DER Ed25519 Public Key (Safe for desktop client verification)
ED25519_PUBLIC_KEY_SPKI=MCowBQYDK2VwAyEAeoPZrf3Wf08HXWcDNbskAEACSUoW0ueZ2Bmltmji9DQ=

# ----------------- PAYMENT GATEWAY WEBHOOKS (MoR) -----------------
LEMONSQUEEZY_API_KEY=replace_with_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=replace_with_lemonsqueezy_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_lemonsqueezy_webhook_secret

PADDLE_VENDOR_ID=replace_with_paddle_vendor_id
PADDLE_API_KEY=replace_with_paddle_api_key
PADDLE_WEBHOOK_SECRET=replace_with_paddle_webhook_secret

STRIPE_SECRET_KEY=replace_with_stripe_secret_key_if_applicable
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret_if_applicable

# ----------------- GOOGLE GEMINI AI CONFIGURATION -----------------
# Note: For desktop users, stored in Windows Credential Manager. For backend server jobs:
GEMINI_API_KEY=replace_with_google_gemini_api_key
GEMINI_PRIMARY_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002

# ----------------- GOOGLE YOUTUBE DATA API v3 -----------------
# Desktop OAuth client configuration
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8911
